# Copy to .env.local and fill in to connect the app to real backends.
# The app runs fully on bundled sample data with these left blank —
# see src/services/* and src/lib/supabase.ts / src/lib/stripe.ts.

# Supabase (supabase/schema.sql)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (publishable key only — secret key lives server-side, never in the app)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
